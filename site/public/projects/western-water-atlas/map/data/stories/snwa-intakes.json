 "facts": {
  "intake3": [
   "Began delivering water to SNWA\u2019s treatment facilities in September 2015.",
   "Construction began in 2008; a 24-ft tunnel-boring machine dug under Lake Mead to an intake anchored to the lake bottom.",
   "Keeps Southern Nevada able to draw water below Lake Mead\u2019s 895-ft \u201cdead pool,\u201d when no water can pass Hoover Dam."
  ],
  "lllps": [
   "Completed in 2020; started operating in April 2022, when a falling Lake Mead knocked one of the primary intake pumping stations out of service.",
   "Can deliver up to 900 million gallons a day to the treatment facilities.",
   "Built for $522 million against a $650 million estimate: a 26-ft shaft over 500 ft deep, an underground forebay, and 34 pump shafts."
  ]
 },
 "note": "Lake Mead\u2019s level has fallen about 160 feet since 2000 (SNWA). Intakes 1 and 2 are older and shallower; their dates are not given on the cited page."
}