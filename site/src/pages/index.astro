---
import Layout from '../layouts/Layout.astro';
import LinkCard from '../components/LinkCard.astro';
---

<Layout title="David A. Lisk">
	<section class="mb-16 sm:mb-24">
	<p class="text-lg text-fg leading-relaxed mb-4 max-w-[60ch]">
			Mechanical Engineer | NYU Stern MBA
		</p>
		<p class="text-lg text-fg leading-relaxed mb-4 max-w-[60ch]">
			I build and deploy AI systems for real operations: production agents, data pipelines, and research on AI markets.
		</p>
	</section>

	<section class="mb-12">
		<h2 class="font-serif text-xl font-medium text-fg mb-4">Selected work</h2>
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
			<LinkCard
				href="/projects/openrouter-llm-substitution"
				title="LLM Substitution on OpenRouter"
				subtitle="NYU Stern research: data pipeline and demand model across 53 LLMs"
			/>
			<LinkCard
				href="/writing/industrial-vibe-coding"
				title="The Embedded Toolmaker"
				subtitle="Why AI-built tools are the future of industrial operations"
			/>
			<LinkCard
				href="/projects/the-film-atlas"
				title="The Film Atlas"
				subtitle="An interactive map of 10,000 films, built with embeddings and clustering"
			/>
		</div>
	</section>

	<section>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<LinkCard
				href="/writing"
				title="Writing"
				subtitle="Technology · Product Management · Corporate Strategy"
			/>
			<LinkCard
				href="/projects"
				title="Projects"
				subtitle="Selected works and experiments"
			/>
			<LinkCard
				href="/about"
				title="About"
				subtitle="Background and contact"
			/>
			<LinkCard
				href="/tags"
				title="Tags"
				subtitle="Explore by topic"
			/>
		</div>
	</section>
</Layout>
